# ---------------------------------------------------------------------------
# Mail Burstly — the edge.
#
# One proxy for the local stack and for production. The site address comes
# from the environment:
#
#   SITE_ADDRESS unset          -> :80, plain HTTP, any host  (local)
#   SITE_ADDRESS=mailburstly…   -> automatic HTTPS, real certificate
#
# The React SPA is baked into this image, so the edge does two things:
# serve the files, and route the paths that belong to a backend.
#
# Caddy resolves an upstream name per request, so a recreated api container
# is picked up without restarting the proxy.
# ---------------------------------------------------------------------------
{
	# email cert-issues@openehsaan.com
}

{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Liveness of the proxy itself: the backends can be down and this still
	# answers ok. The deploy pipeline checks this over the public address.
	handle /health {
		respond "ok" 200
	}

	# REST api -> Hono
	handle /api/* {
		reverse_proxy api:3001
	}

	# WebSocket fan-out -> Hono
	handle /ws* {
		reverse_proxy api:3001
	}

	# Mailcore: OAuth start/callback, tracking pixel, click redirect and
	# unsubscribe. These have to be reachable from the public internet — a
	# tracking pixel is loaded by the recipient's mail client — so they are
	# proxied instead of falling back to the SPA.
	handle /oauth/* {
		reverse_proxy mailcore:3004
	}
	handle /t/* {
		reverse_proxy mailcore:3004
	}
	handle /u/* {
		reverse_proxy mailcore:3004
	}

	# Hashed build assets: immutable, and a missing one is a 404, never the
	# app shell (a stale bundle would break the app in a confusing way).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		try_files {path} =404
		file_server
	}

	# The React SPA.
	handle {
		root * /srv

		# "/" is the static landing page, never the SPA: the app's own routes
		# sit behind a session, and a home page that logs you out is not a
		# home page. Serving it from disk also means it needs no JavaScript
		# to explain what the app is, which is what the Google OAuth review
		# looks for.
		@landing path /
		rewrite @landing /landing.html

		# Everything left is the app shell, and it has to be revalidated — a
		# deploy would otherwise leave the browser on a stale build.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		# SPA fallback: every unknown path serves index.html so React Router
		# works.
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# TIEPOINT — a second app on this server: its API, behind this same edge.
#
# This proxy owns ports 80/443 on the VPS, so the TIEPOINT stack runs without
# a proxy of its own. Its API container joins this stack's network
# (mailrung_default) under the alias `tiepoint-api` — never a bare `api`,
# which is ours. The site gets its own certificate, like the one above.
#
#   TIEPOINT_API_ADDRESS unset  -> api-tie.openehsaan.com (production)
#   TIEPOINT_API_ADDRESS=http://tiepoint-api.localhost  -> local: no
#     certificate requests for a domain that does not point here
#
# Source of truth for this block: tiepoint repo, api/deploy/caddy/.
# ---------------------------------------------------------------------------
{$TIEPOINT_API_ADDRESS:api-tie.openehsaan.com} {
	# uploads: the TIEPOINT UI sends up to 15 files per request, each at most
	# 100 MB. Caddy streams the body to the upstream; it does not spool it.
	request_body {
		max_size 1600MB
	}

	# the API is all there is on this domain (its UI is on Vercel)
	handle /api/* {
		reverse_proxy tiepoint-api:8000 {
			transport http {
				# an upload is hashed and stored before the response
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
	handle {
		respond 404
	}
}
