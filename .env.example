# ---------------------------------------------------------------------------
# Mailrung — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
WORKSPACE_NAME=Mailrung
WORKSPACE_TIMEZONE=Asia/Karachi

# --- Postgres ---
# Host port 5433 (5432 is taken by another project on this machine).
# Inside compose, services use postgres:5432.
POSTGRES_USER=mailrung
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mailrung
POSTGRES_URL=postgres://mailrung:change-me-postgres@localhost:5433/mailrung

# --- Redis ---
# Host port 6380 (6379 is taken by another project on this machine).
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=dev-only-session-secret-please-replace-with-32-plus-bytes

# --- Web ---
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# --- EmailEngine (self-hosted) ---
# EmailEngine runs at port 3003 (host) / 3000 (container).
# Admin UI: http://localhost:3003/admin (no password by default).
EMAILENGINE_PUBLIC_URL=http://localhost:3003
EMAILENGINE_API_URL=http://localhost:3003
EMAILENGINE_PORT=3000

# EmailEngine's admin UI session secret (any 32+ char string).
EMAILENGINE_SECRET=change-me-emailengine-secret

# API token for calling EmailEngine's REST API.
# Create one with: docker exec mailrung-emailengine-1 node /emailengine/bin/emailengine.js tokens issue -d "mailrung" -s "*" --dbs.redis="redis://redis:6379"
EMAILENGINE_API_TOKEN=

# Webhook secret for verifying EmailEngine's inbound webhooks.
EMAILENGINE_WEBHOOK_SECRET=change-me-webhook-secret

# The HMAC key EmailEngine signs its webhooks with. It must match the
# `serviceSecret` set on EmailEngine:
#   curl -X POST http://localhost:3003/v1/settings -H "Authorization: Bearer $EMAILENGINE_API_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d "{\"serviceSecret\": \"$EMAILENGINE_SERVICE_SECRET\", \"webhooks\": \"$WORKER_WEBHOOK_URL\", \"webhooksEnabled\": true, \"webhookEvents\": [\"messageNew\",\"messageSent\",\"messageBounce\",\"messageComplaint\",\"trackOpen\",\"trackClick\",\"listUnsubscribe\"], \"notifyText\": true}"
# Generate one with: openssl rand -hex 32
EMAILENGINE_SERVICE_SECRET=

# Our worker's public path for inbound mail webhooks.
WORKER_WEBHOOK_URL=http://worker:3002/webhooks/emailengine

# --- OAuth2 app IDs from EmailEngine's Integrations > OAuth2 Apps ---
# 1. Start EmailEngine, open http://localhost:3003/admin
# 2. Go to Integrations > OAuth2 Apps > Create > Gmail (or Outlook)
# 3. Provide your Google Cloud Console client ID and secret
# 4. Copy the app ID from the list and set it here
GOOGLE_OAUTH_APP_ID=
MICROSOFT_OAUTH_APP_ID=

# --- Microsoft (Entra) app registration ---
# Only needed to connect an Outlook / Microsoft 365 mailbox. Create an app
# registration in the Entra admin center, add a client secret, and register
# the redirect URI as a Web platform: <EMAILENGINE_PUBLIC_URL>/oauth
# (http://localhost:3003/oauth for local development).
#
# Then register the app with EmailEngine and let it write MICROSOFT_OAUTH_APP_ID:
#   bun run scripts/setup-microsoft-oauth.ts
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" covers both work accounts and personal Microsoft accounts.
# A single-tenant setup can use the tenant id instead.
MICROSOFT_AUTHORITY=common
# How EmailEngine reads the mailbox.
#   imap — IMAP/SMTP with OAuth2. Works anywhere, polls for new mail.
#          Needs the Exchange Online delegated permissions on the app
#          registration: IMAP.AccessAsUser.All, SMTP.Send.
#   api  — Microsoft Graph. Push notifications, but Graph needs a public
#          HTTPS notification URL, so it only works when EmailEngine is
#          reachable over HTTPS.
MICROSOFT_BASE_SCOPES=imap

# --- LLM (reply classification + suggestions) ---
# --- Reply classification (optional) ---------------------------------------
# With no key, the rule-based classifier answers every reply and nothing
# else changes. With a key, replies are classified by the model.
#
# Ollama cloud: create a key at https://ollama.com/settings/keys
#   https://ollama.com/api/tags lists the models you can use.
#   https://ollama.com/settings/usage shows what you have spent.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com

# The model that classifies replies.
#
# A decision model uses Ollama's /v1/systemone endpoint: it returns a
# probability for each label and a real confidence score, which is what
# LLM_CLASSIFY_MIN_CONFIDENCE is compared against. "clef:27b" costs
# $0.24 per million input tokens and nothing for output.
#
# Any other model uses /v1/chat/completions and returns free-form JSON.
# "gpt-oss:20b" is $0.07 per million input tokens and works on the free
# plan; "nemotron-3-super" is $0.015.
LLM_MODEL=clef:27b

# Answers below this confidence are not acted on: no label is applied and
# the reply is left in the inbox for a human.
LLM_CLASSIFY_MIN_CONFIDENCE=0.7
LLM_TIMEOUT_MS=15000

# --- Email verification ---
VERIFICATION_PROVIDER=neverbounce
VERIFICATION_API_KEY=
VERIFICATION_DAILY_CAP=5000

# --- Bootstrap admin (created by `bun run db:seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
# --- Mailcore (EmailEngine replacement, WIP) ---
# Go service at apps/mailcore. Set EMAILENGINE_API_URL=http://mailcore:3004
# (and EMAILENGINE_API_TOKEN=MAILCORE_API_TOKEN) to cut over. Trial in progress.
MAILCORE_PORT=3004
MAILCORE_PUBLIC_URL=http://localhost:3004
MAILCORE_API_TOKEN=
MAILCORE_WEBHOOK_SECRET=
MAILCORE_ENCRYPTION_KEY=        # `openssl rand -base64 32`
MAILCORE_SYNC_INTERVAL=30
MAILCORE_INITIAL_SYNC_DAYS=14
MAILCORE_TENANT=common          # alias of MICROSOFT_AUTHORITY
