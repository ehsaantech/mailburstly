# ---------------------------------------------------------------------------
# Mailrung — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
WORKSPACE_NAME=Mailrung
WORKSPACE_TIMEZONE=Asia/Karachi

# --- Postgres ---
# Host port 5433 (5432 is taken by another project on this machine).
# Inside compose, services use postgres:5432.
POSTGRES_USER=mailrung
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mailrung
POSTGRES_URL=postgres://mailrung:change-me-postgres@localhost:5433/mailrung

# --- Redis ---
# Host port 6380 (6379 is taken by another project on this machine).
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3001
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=dev-only-session-secret-please-replace-with-32-plus-bytes

# --- Edge (Caddy) ---
# The one proxy: it serves the built React SPA and routes /api, /ws and the
# mailcore paths (/oauth, /t, /u). Locally it is plain HTTP on host port 8080.
#
# In production:
#   SITE_ADDRESS=mailburstly.openehsaan.com   -> automatic HTTPS
# The compose default for the host ports is the production one (80/443).
HTTP_PORT=8080
HTTPS_PORT=443
SITE_ADDRESS=:80

# --- Web ---
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# --- Google site verification ---
# The token Google gives you for "mailburstly.openehsaan.com" (OAuth consent
# screen > Branding > Homepage > Ownership verification). It is public, not a
# secret: the build puts it in a <meta name="google-site-verification"> tag
# on the home page. Leave it empty to ship the page without the tag.
# DNS TXT and the HTML-file method work too — see README.
GOOGLE_SITE_VERIFICATION=

# --- Mailcore (the mail gateway) ---
# A TypeScript service at apps/mailcore. It owns every protocol detail:
# OAuth2 consent, IMAP/SMTP transport, the Gmail API, Microsoft Graph,
# tracking, and the mail events the worker consumes. The api, worker and
# dispatcher all talk to it over MAILCORE_API_URL, presenting
# MAILCORE_API_TOKEN. It runs at port 3004 (host and container).
MAILCORE_API_URL=http://mailcore:3004
# The public address of mailcore: the OAuth redirect, the tracking pixel and
# the post-consent redirect all use it. In production this is the same host
# as PUBLIC_URL.
MAILCORE_PUBLIC_URL=http://localhost:8080
MAILCORE_PORT=3004

# The API token the api, worker and dispatcher present to mailcore.
# Every one of them must present the same value. Generate one with:
#   openssl rand -hex 32
MAILCORE_API_TOKEN=

# The HMAC key mailcore signs its webhooks with, and the worker verifies
# them with. They must be the same value: a mismatch silently rejects every
# mail event. Generate one with: openssl rand -hex 32
MAILCORE_WEBHOOK_SECRET=

# 32-byte key (base64) that encrypts OAuth tokens at rest. Changing it
# orphans every stored token. Generate one with: openssl rand -base64 32
MAILCORE_ENCRYPTION_KEY=
# How often mailcore polls each mailbox for new mail.
MAILCORE_SYNC_INTERVAL=30
# How many days of history the first sync imports.
MAILCORE_INITIAL_SYNC_DAYS=14

# Our worker's public path for inbound mail webhooks.
WORKER_WEBHOOK_URL=http://worker:3002/webhooks/mailcore

# --- Google (Gmail) ---
# Only needed to connect a Gmail mailbox. Create an OAuth2 client in the
# Google Cloud console, and set the redirect URI as a Web platform:
# <MAILCORE_PUBLIC_URL>/oauth/callback
# (http://localhost:8080/oauth/callback for local development).
#
# Never ship the app left in "Testing": Google issues refresh tokens that
# expire after 7 days, so every mailbox would die weekly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Entra) app registration ---
# Only needed to connect an Outlook / Microsoft 365 mailbox. Create an app
# registration in the Entra admin center, add a client secret, and register
# the redirect URI as a Web platform: <MAILCORE_PUBLIC_URL>/oauth/callback
# (http://localhost:8080/oauth/callback for local development).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" covers both work accounts and personal Microsoft accounts.
# A single-tenant setup can use the tenant id instead.
MICROSOFT_AUTHORITY=common

# --- LLM (reply classification + suggestions) ---
# --- Reply classification (optional) ---------------------------------------
# With no key, the rule-based classifier answers every reply and nothing
# else changes. With a key, replies are classified by the model.
#
# Ollama cloud: create a key at https://ollama.com/settings/keys
#   https://ollama.com/api/tags lists the models you can use.
#   https://ollama.com/settings/usage shows what you have spent.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com

# The model that classifies replies.
#
# A decision model uses Ollama's /v1/systemone endpoint: it returns a
# probability for each label and a real confidence score, which is what
# LLM_CLASSIFY_MIN_CONFIDENCE is compared against. "clef:27b" costs
# $0.24 per million input tokens and nothing for output.
#
# Any other model uses /v1/chat/completions and returns free-form JSON.
# "gpt-oss:20b" is $0.07 per million input tokens and works on the free
# plan; "nemotron-3-super" is $0.015.
LLM_MODEL=clef:27b

# Answers below this confidence are not acted on: no label is applied and
# the reply is left in the inbox for a human.
LLM_CLASSIFY_MIN_CONFIDENCE=0.7
LLM_TIMEOUT_MS=15000

# --- Email verification ---
VERIFICATION_PROVIDER=neverbounce
VERIFICATION_API_KEY=
VERIFICATION_DAILY_CAP=5000

# --- Alerting (Resend) ---
# When something breaks — above all when the system fails to send an email —
# an alert goes to the addresses in the `alert_recipients` table. Those are
# managed in the dashboard (Settings → Alert recipients); the seed below only
# decides who is there on a fresh database.
#
# Resend is a separate provider from the mail gateway we send campaigns
# through, on purpose: an alert still goes out when the gateway is the thing
# that broke.
#
# The key must be scoped to the sending domain below, or Resend refuses to
# send from it.
#
#   https://resend.com/api-keys
RESEND_API_KEY=

# The verified sender. Any address on a verified domain works; the address
# itself does not have to exist.
ALERT_FROM_EMAIL=alerts@mail.ehsaanlabs.com

# Set to false to mute alerts without removing the key.
ALERT_ENABLED=true

# How long one kind of failure stays quiet before it is mailed again. Five
# minutes: a campaign that fails five hundred times produces one email, and
# the next one says how many were folded into it.
ALERT_COOLDOWN_MS=300000

# Hard cap on alert emails per hour, across every kind of failure.
ALERT_MAX_PER_HOUR=20

# Who gets an alert on a fresh database. Comma separated.
ALERT_RECIPIENTS=haroon@ehsaantech.com

# --- Bootstrap admin (created by `bun run db:seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin

